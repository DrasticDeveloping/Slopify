{
  "name": "slopify-cloud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Slopify's online service: accounts, cloud library sync and Listen Along (Cloudflare Workers)",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply slopify --local",
    "db:migrate": "wrangler d1 migrations apply slopify --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
