{
  // Slopify's online service. See docs/cloud.md for setup and deployment.
  "name": "slopify-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    // Create it with `npx wrangler d1 create slopify`, then put its id here.
    // preview_database_id: the previews' database (see "previews" below), for `npm run db:migrate:preview`.
    { "binding": "DB", "database_name": "slopify", "database_id": "d0512d09-5cff-4dd4-8ec0-1b157cf27f20", "preview_database_id": "005ff493-513d-41ec-9285-667f44e68c13", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ListenAlongRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ListenRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ListenAlongRoom"] },
    // Ends every room made before rooms had a longest lifetime and a record of their members (src/room.ts).
    // Separate from v2: Cloudflare won't delete a class in the deploy that moves its binding to another.
    { "tag": "v3", "deleted_classes": ["ListenRoom"] }
  ],
  // Daily: removes deletion and room records that are no longer needed (`tidy` in src/library.ts).
  "triggers": { "crons": ["17 4 * * *"] },
  // Calls a minute per account, and per address before sign-in is checked (src/index.ts).
  // A first sync of a big library sends one call per song, so the account limit leaves room for that.
  "ratelimits": [
    { "name": "USER_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "ADDRESS_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
  ],
  // Workers Logs: the dashboard counts calls by route from the one line src/index.ts logs per call.
  // Cloudflare's own per-call logs are off: they'd keep each call's address, with WebSocket tokens in it.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  },
  "vars": {
    // Your Clerk application's Publishable Key (pk_test_… or pk_live_…). It is public.
    "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuc2xvcGlmeS51bmJsb2NrZWQubW92JA"
  },
  // Previews (`npx wrangler preview`, and a pull request's own: .github/workflows/cloud-preview.yml) try a branch at
  // its own address without touching production. They don't take the settings above: their database is a separate
  // one with no real accounts (`npm run db:migrate:preview` applies migrations to it), their call limits are
  // counted apart, and each gets its own Listen Along rooms (Durable Objects). Daily tidying (the cron) doesn't run
  // on them. Sign-in is the same Clerk app, so a real account signs in, with an empty library there.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "ROOMS", "class_name": "ListenAlongRoom" }]
    },
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "logs": { "invocation_logs": false }
    },
    "d1_databases": [
      { "binding": "DB", "database_name": "slopify-preview", "database_id": "005ff493-513d-41ec-9285-667f44e68c13", "migrations_dir": "migrations" }
    ],
    "ratelimits": [
      { "name": "USER_LIMIT", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } },
      { "name": "ADDRESS_LIMIT", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } }
    ],
    "vars": {
      "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuc2xvcGlmeS51bmJsb2NrZWQubW92JA"
    }
  }
}
