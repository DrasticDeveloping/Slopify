{
  "name": "resonance-remastered",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Slopify music player with a built-in local music server",
  "author": "DrasticDeveloping",
  "main": "desktop/main.cjs",
  "scripts": {
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "vite",
    "dev:isolated": "node scripts/isolated.mjs dev",
    "desktop:isolated": "node scripts/isolated.mjs desktop",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs",
    "preview": "vite preview",
    "start": "node server/main.mjs",
    "typecheck": "tsc -b",
    "desktop": "npm run build && node scripts/run-desktop.mjs",
    "dist:win": "npm run build && node scripts/package-windows.mjs",
    "dist:win:nightly": "npm run build && node scripts/package-windows.mjs --channel nightly",
    "dist:win:portable": "npm run build && node scripts/package-windows.mjs --portable",
    "dist:win:unpacked": "npm run build && node scripts/package-windows.mjs --dir",
    "release:nightly": "npm run dist:win:nightly && node scripts/publish-release.mjs",
    "release:stable": "npm run dist:win && node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@clerk/react": "^6.17.8",
    "@fontsource-variable/inter": "^5.3.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
